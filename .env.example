# Optional keys for solana-token-intel. Everything works without them.
# Easiest: run  python3 skills/solana-token-intel/scripts/cli.py setup
# Or copy this file to ~/.config/solana-token-intel/.env and fill it in.
# Environment variables with the same names win over the file.

# Private RPC for mints, holders and transactions (e.g. a Helius RPC URL).
SOLANA_RPC_URL=
# Full transaction history for origin lookups.
HELIUS_API_KEY=
# Price history across all pools.
BIRDEYE_API_KEY=
# RPC for Artist Passport lookups. Empty = devnet.
PASSPORT_RPC_URL=
