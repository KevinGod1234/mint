# Optional keys for mint. Everything works without them.
# Easiest: run /mint:setup in Claude Code; it creates your keys file.
# Or copy this file to ~/.config/mint-solana/.env and fill it in.
# Environment variables with the same names win over the file.

# Private RPC for mints, holders and transactions (e.g. a Helius RPC URL).
SOLANA_RPC_URL=
# Full transaction history for origin lookups.
HELIUS_API_KEY=
# Price history across all pools.
BIRDEYE_API_KEY=
# Safety budget: requests per source per hour, across all lookups. Default 200.
MINT_MAX_CALLS_PER_HOUR=
